{
  "permissions": {
    "defaultMode": "default",
    "disableBypassPermissionsMode": "disable",
    "ask": [
      "Bash(git push *)"
    ],
    "allow": [
      "Read(./backend/.env.example)",
      "Write(./backend/.env.example)",
      "Edit(./backend/.env.example)"
    ],
    "deny": [
      "Bash(rm *)",
      "Bash(rmdir *)",
      "Bash(del *)",
      "Bash(Remove-Item *)",
      "Bash(sqlite3 *)",
      "Read(./backend/.env)",
      "Edit(./backend/.env)",
      "Write(./backend/.env)"
    ]
  }
}
