# 本地开发连真实 FastAPI(后端默认端口 8000)
VITE_API_BASE_URL=http://localhost:8000

# 数据源开关(vercel-display 演示分支)。留空/不设 = 走上面的真实 API。
# 设成 mock = 全部走 src/lib/mock,不发任何网络请求:
#   bash:       VITE_DATA_SOURCE=mock npm run dev
#   PowerShell: $env:VITE_DATA_SOURCE='mock'; npm run dev
#
# production 构建(npm run build / Vercel)默认就是 mock,默认值在 vite.config.ts 里,
# 不在 .env.production —— 仓库根 .gitignore 的 `.env.*` 会把那种文件挡在 git 之外,
# Vercel 上拿不到,反而会构建出连真实后端的版本。
VITE_DATA_SOURCE=
